import:
	java.util.Base64

on load:
	# それぞれのvalue/signatureの保存
	# [Gray] URL: https://mineskin.org/skins/a0451ad757564510b401134ca31b4227
	set {-tablist::value::gray} to ""
	set {-tablist::signature::gray} to ""

function updateKitTablist():
	set {_game} to {Kit-tochu}
	if {_game} is false:
		setKitTablist_Lobby()
		stop
	setKitTablist_Match()

local function setKitTablist_Lobby():
	set {_slot} to 0
	set {_players::*} to all players
	for {_lp} in {_players::*}:
		set {_text} to "%name of {_lp}%"
		setTablistSlotFromPlayer({_slot}, {_text}, {_lp})

		add 1 to {_slot}
	
	set {_remain} to 80 - {_slot}
	set {_text} to "                    "
	# memo
	# [Gray] URL: https://mineskin.org/skins/a0451ad757564510b401134ca31b4227
	loop {_remain} times:
		setTablistSlot({_slot}, {_text}, {-tablist::value::gray}, {-tablist::signature::gray})
		add 1 to {_slot}

local function setKitTablist_Match():

on join:
	updateKitTablist()

on quit:
	updateKitTablist()