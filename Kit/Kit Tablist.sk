import:
	java.util.Base64

on load:
	# それぞれのvalue/signatureの保存
	# [Gray] URL: https://mineskin.org/skins/a0451ad757564510b401134ca31b4227
	set {-tablist::value::gray} to ""
	set {-tablist::signature::gray} to ""
	# [Red] URL: https://mineskin.org/skins/b41e78d17fed4828b6f5948a2498618f
	set {-tablist::value::red} to ""
	set {-tablist::signature::red} to ""
	# [Blue] URL: https://mineskin.org/skins/5913e00e7b3542f19916f55d0bf40b31
	set {-tablist::value::blue} to ""
	set {-tablist::signature::blue} to ""
	# [Yellow] URL: https://mineskin.org/skins/f0d22d07a91641319946a60e9d3399d3
	set {-tablist::value::yellow} to ""
	set {-tablist::signature::yellow} to ""
	# [Green] URL: https://mineskin.org/skins/5e9e786e8811402a89c92b746ec9c186
	set {-tablist::value::green} to ""
	set {-tablist::signature::green} to ""

function updateKitTablist():
	set {_game} to {Kit-tochu}
	if {_game} is false:
		setKitTablist_Lobby()
		stop
	setKitTablist_Match()

local function setKitTablist_Lobby():
	set {_slot} to 0
	set {_players::*} to all players
	for {_lp} in {_players::*}:
		set {_text} to "%name of {_lp}%"
		setTablistSlotFromPlayer({_slot}, {_text}, {_lp})

		add 1 to {_slot}
	
	set {_remain} to 80 - {_slot}
	set {_text} to "                    "

	loop {_remain} times:
		setTablistSlot({_slot}, {_text}, {-tablist::value::gray}, {-tablist::signature::gray})
		add 1 to {_slot}

local function setKitTablist_Match():

on join:
	updateKitTablist()

on quit:
	updateKitTablist()