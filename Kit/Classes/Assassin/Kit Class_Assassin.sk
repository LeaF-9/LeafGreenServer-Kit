# Assassinのスキル Ver1.0.0

options:
	assassination-approach: "Assassination - Approach"
	assassination-behind: "Assassination - Behind"

# Abilities
on damage of player:
	damage was caused by fall
	{Class::%victim%} is "Assassin"
	cancel event

on damage with priority LOW:
	damage was caused by attack
	set {_attacker} to getAttacker(victim)
	getKitClass({_attacker}) is "Assassin"
	checkCT({_attacker}, "Assassination") is true

	set {_tool} to tool of {_attacker}
	set {_key} to getNamespacedKey({_tool}, "item-key", "string")
	stop if {_key} is "ScatKnife"

	set {_UltAssassin} to getKitStats({_player}, "UltAssassin")
	{_UltAssassin} is not set

	set {_ok} to true if victim's facing is {_attacker}'s facing
	stop if {_ok} is not true

	kitMsg({_attacker}, "§4不意打ち効果でダメージが2倍になった!")
	playSound("entity.arrow.hit_player", 1, 0.75, {_attacker}, true)
	send action bar "§c不意を突かれた!" to victim
	particleAssassinationBehind(victim)

	setDamageModification_MUL(victim, 2)
	setAssassination({_attacker}, "BEHIND")
	kitEffect_Pursuit_Prepare(victim)

	setAssassinationCoolTime({_attacker})

	set {_dis} to distance between {_attacker} and victim
	stop if {_dis} > 1

	kitMsg({_attacker}, "§4近距離効果でダメージが増加します!")
	soundAssassinationApproach({_attacker})
	send action bar "§c接近されてしまった!" to victim
	particleAssassinationApproach(victim)

	set {_addDamage} to (1 - {_dis}) * 2
	setDamageModification_ADD(victim, {_addDamage})
	setAssassination({_attacker}, "APPROACH")

local function setAssassinationCoolTime(player: player):
	setCT({_player}, "Assassination", 5)
	sendTimeBossbar_YELLOW({_player}, "§4§lAssassination §7- §9Cool Time", 100)

local function particleAssassinationBehind(entity: entity):
	loop 20 times:
		set {_el} to aroundEffect({_entity})
		spawnParticle_BlockData(dust_pillar, redstone block, {_el})

local function particleAssassinationApproach(entity: entity):
	loop 30 times:
		set {_el} to aroundEffect({_entity})
		spawnParticle_BlockData(block_crumble, magma block, {_el})

local function soundAssassinationApproach(player: player):
	set {_pitch} to 1.5
	set {_addpitch} to 0.4
	loop 3 times:
		playSound("entity.arrow.hit_player", 1, {_pitch}, {_player}, true)
		add {_addpitch} to {_pitch}
		set {_pitch} to 2 if {_pitch} > 2
		wait 2 ticks

local function setAssassination(player: player, type: text):
	set {_tag} to getAssassinationTag({_type})
	stop if {_tag} is not set

	set {_uuid} to a random uuid
	setMetadata({_player}, {_tag}, {_uuid})

	wait a tick
	stop if getMetadata({_player}, {_tag}) is not {_uuid}
	deleteMetadata({_player}, {_tag})

local function getAssassinationTag(type: text) :: text:
	set {_tag} to {@assassination-approach} if {_type} is "APPROACH"
	set {_tag} to {@assassination-behind} if {_type} is "BEHIND"
	stop if {_tag} is not set
	return {_tag}

function getAssassinationStatus(player: player, type: text) :: boolean:
	set {_tag} to getAssassinationTag({_type})
	stop if {_tag} is not set

	set {_status} to getMetadata({_player}, {_tag})

	return true if {_status} is set
	return false