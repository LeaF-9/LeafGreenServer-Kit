# Kunai

options:
	kunai-key: "kunai-remaining"  # 残留クナイ判別用のmetadataキー
	kunai-speed: 1                # 1tickあたりの移動距離(m) → 0.5秒(10tick)で10m
	kunai-range: 10               # 最大飛距離(m)
	kunai-step: 0.25              # 1tick内のヒット確認間隔(m)
	kunai-damage: 0.5             # プレイヤーヒット時の与ダメージ(❤)
	kunai-remain: 40              # 残留時間(tick) = 2秒
	kunai-power: 2                # 爆風威力
	kunai-scale: 0.75             # ディスプレイの大きさ
	kunai-detonate-key: "kunai-detonating"  # 起爆待機中のクナイ判別用のmetadataキー
	kunai-detonate-delay: 10      # 起爆ディレイ(tick) = 0.5秒
	kunai-detonate-scale: 2     # 起爆待機中の拡大倍率 (kunai-scale基準)
	kunai-spark-amount: 3         # 起爆待機中のfirework粒数 (1tickあたり)
	kunai-spark-speed: 0.3        # 起爆待機中のfireworkの飛び散る速さ

# 右クリック: クナイの発射
function kitEffect_Kunai(player: player):
	nameItemCT({_player}, "Kunai")

	set {_baseloc} to head of {_player}
	set {_display} to kitKunai_SpawnDisplay(location 0.5 meters in front of {_baseloc})

	# --- 発射音 ---
	playSound("entity.arrow.shoot", 1, 1.5, {_player})
	playSound("item.trident.throw", 0.6, 2, {_player})
	# -------------

	set {_steps} to {@kunai-speed} / {@kunai-step}
	set {_dist} to 0
	loop ({@kunai-range} / {@kunai-speed}) times:
		if {_player} is not online:
			{_display}.remove()
			stop

		# --- 1tick分の移動経路をヒット確認 ---
		loop {_steps} times:
			add {@kunai-step} to {_dist}
			set {_checkloc} to location {_dist} meters in front of {_baseloc}

			# エンティティヒット: ダメージを与えてクナイは消滅
			set {_entities::*} to checkHitEntities({_checkloc})
			for {_entity} in {_entities::*}:
				kitCheckTeam({_player}, {_entity}, false) is true
				{_display}.remove()
				kitEffect_Kunai_Hit({_player}, {_entity}, {_checkloc})
				stop

			# ブロックヒット: 着弾地点にクナイを残留
			if block at {_checkloc} is not passable:
				set {_kunailoc} to kitKunai_GetSurface({_baseloc}, {_dist})
				kitEffect_Kunai_Remain({_player}, {_display}, {_kunailoc})
				stop
		# ----------------------------------

		teleport {_display} to location {_dist} meters in front of {_baseloc}
		kitParticle_Kunai_Trail(location of {_display})
		wait a tick

	# 何にも当たらず最大飛距離に到達 → 消滅
	kitParticle_Kunai_Vanish(location of {_display})
	{_display}.remove()

# スニーク + 左クリック: 残留クナイの起爆
function kitEffect_Kunai_LeftClick(player: player, event: object):
	{_player} is sneaking

	set {_kunais::*} to kitKunai_GetRemaining({_player})
	set {_count} to size of {_kunais::*}
	stop if {_count} is 0

	# --- クールタイム [クナイ個数]秒 ---
	set {_tool} to {_player}'s tool
	set {_ct} to "%{_count}% seconds" parsed as time span
	set item cooldown of {_tool} for {_player} to {_ct}
	# ---------------------------------

	playSound("entity.tnt.primed", 1, 2, {_player}, true)

	# --- 起爆待機: 光の矢に変化 & 発光 & 0.5秒かけて拡大 ---
	set {_matrix} to kitKunai_GetMatrix({@kunai-scale} * {@kunai-detonate-scale})
	for {_kunai} in {_kunais::*}:
		delete metadata value {@kunai-key} of {_kunai}  # 再起爆の対象外にする
		set metadata value {@kunai-detonate-key} of {_kunai} to true  # 2秒後消滅を無効化
		setDisplayItem({_kunai}, spectral arrow)
		{_kunai}.setGlowing(true)
		{_kunai}.setInterpolationDelay(0)
		{_kunai}.setInterpolationDuration({@kunai-detonate-delay})
		{_kunai}.setTransformationMatrix({_matrix})
	# ---------------------------------------------------

	# --- 起爆待機中の演出 (毎tick) ---
	loop {@kunai-detonate-delay} times:
		for {_kunai} in {_kunais::*}:
			kitParticle_Kunai_Detonating(location of {_kunai})
		wait a tick
	# ------------------------------

	for {_kunai} in {_kunais::*}:
		set {_loc} to location of {_kunai}
		{_kunai}.remove()
		kitExplosion({_player}, {@kunai-power}, {_loc}) if {_player} is online

# --- 飛行中のヒット処理 ---
local function kitEffect_Kunai_Hit(player: player, victim: entity, loc: location):
	kitDamage({_player}, {_victim}, {@kunai-damage}, "苦無")
	kitParticle_Kunai_Hit({_loc})
	playSound("entity.arrow.hit_player", 1, 1.2, {_player}, true)

# --- 残留処理 ---
local function kitEffect_Kunai_Remain(player: player, display: entity, loc: location):
	teleport {_display} to {_loc}
	set metadata value {@kunai-key} of {_display} to "%uuid of {_player}%"
	packetGlowing({_player}, {_display})
	kitParticle_Kunai_Stick({_loc})

	loop {@kunai-remain} times:
		wait a tick
		stop if {_display}.isValid() is false  # 起爆済み
		stop if metadata value {@kunai-detonate-key} of {_display} is set  # 起爆待機中
		if mod(loop-number, 10) is 0:
			spawnParticle_Dust(rgb(183, 40, 46), 0.6, {_loc}, {_player})

	# 残留時間経過 → 爆発せずに消滅
	kitParticle_Kunai_Vanish({_loc})
	{_display}.remove()

# --- 着弾したブロック表面の座標を取得 ---
# 0.05m刻みで手前に戻って表面を探し, 表面から少し奥 (ブロックに刺さった位置) を返す
local function kitKunai_GetSurface(baseloc: location, dist: number) :: location:
	set {_d} to {_dist}
	loop 5 times:
		set {_back} to {_d} - 0.05
		block at (location {_back} meters in front of {_baseloc}) is not passable
		set {_d} to {_back}
	# {_d} = 最初に固体ブロックとなる距離
	set {_d} to {_d} + 0.05
	return location {_d} meters in front of {_baseloc}

# --- 残留中のクナイ一覧を取得 ---
local function kitKunai_GetRemaining(player: player) :: entities:
	set {_uuid} to "%uuid of {_player}%"
	loop all item displays:
		metadata value {@kunai-key} of loop-item display is {_uuid}
		add loop-item display to {_kunais::*}
	return {_kunais::*}

# --- クナイ(ディスプレイ)の生成 ---
local function kitKunai_SpawnDisplay(loc: location) :: entity:
	set {_item} to an arrow
	set {_matrix} to kitKunai_GetMatrix({@kunai-scale})

	spawn an item display at {_loc}
	set {_itemdisplay} to spawned item display

	setBrightness({_itemdisplay})
	{_itemdisplay}.setTeleportDuration(1)
	{_itemdisplay}.setInterpolationDuration(1)
	{_itemdisplay}.setViewRange(1000)
	setDisplayItem({_itemdisplay}, {_item})
	{_itemdisplay}.setTransformationMatrix({_matrix})

	setGameType({_itemdisplay})
	return {_itemdisplay}

# --- クナイ(ディスプレイ)の変形行列を取得 ---
# 矢の先端が進行方向を向く回転 × 指定倍率
local function kitKunai_GetMatrix(scale: number) :: object:
	set {_a} to 0.7071 * {_scale}
	set {_b} to {_scale} * -1
	set {_matrix} to getAdjustedMatrix4f({_a}, {_a}, 0, 0, 0, 0, {_b}, 0, {_a} * -1, {_a}, 0, 0, 0, 0, 0, 1)
	return {_matrix}

# --- 演出 ---
local function kitParticle_Kunai_Trail(loc: location):
	spawnParticle_Dust(rgb(183, 40, 46), 0.5, {_loc})
	spawnParticle(enchanted_hit, {_loc})

local function kitParticle_Kunai_Hit(loc: location):
	loop 8 times:
		spawnParticle_Vector(enchanted_hit, randomVector(), 0.3, {_loc})

local function kitParticle_Kunai_Stick(loc: location):
	playSound("entity.arrow.hit", 1, 1.2, {_loc})
	playSound("block.chain.place", 1, 2, {_loc})
	set {_block} to type of block at {_loc}
	loop 5 times:
		spawnParticle_Block({_block}, {_loc})

# 起爆待機中: クナイ位置を中心にfireworkが小さく弾ける
local function kitParticle_Kunai_Detonating(loc: location):
	loop {@kunai-spark-amount} times:
		spawnParticle_Vector(firework, randomVector(1), {@kunai-spark-speed}, {_loc})

local function kitParticle_Kunai_Vanish(loc: location):
	spawnParticle(smoke, {_loc})
	playSound("block.chain.break", 1, 2, {_loc})
