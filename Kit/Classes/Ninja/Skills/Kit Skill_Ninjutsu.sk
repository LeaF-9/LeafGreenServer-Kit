# Ninjutsu

options:
	# --- Ninjutsu -風- ---
	# 効果
	kaze-duration: 5  # 竜巻の持続時間 (秒)
	kaze-distance: 10  # 竜巻が持続時間中に進む距離 (m)
	kaze-hit-radius: 5  # 吹き飛ばし範囲 (竜巻中心からの半径 m)
	kaze-hit-interval: 1  # 同じ敵への再ヒット間隔 (秒)
	kaze-launch-power: 1.1  # 打ち上げの上方向速度 (1.0で約6ブロック, 1.2で約8ブロック, 1.4で約11ブロック)
	kaze-fall-damage: 1.5  # 吹き飛ばした敵(プレイヤー)の落下ダメージ (❤)
	# 演出
	kaze-tornado-height: 4  # 竜巻パーティクルの最大高さ (m)
	kaze-tornado-radius: 4 # 竜巻パーティクルの最大半径 (頂上の半径 m)
	kaze-tornado-min-radius: 0.5  # 竜巻パーティクルの最小半径 (根元の半径 m)
	kaze-tornado-layers: 15  # 竜巻パーティクルの段数 (多いほど密)
	kaze-tornado-arms: 4  # 竜巻パーティクルの螺旋の本数
	kaze-particle-size: 1.2  # 竜巻パーティクルの大きさ
	kaze-color-count: 3  # 召喚時にパレットから抽選する色の数
	kaze-colors: rgb(0, 175, 204), rgb(110, 200, 230), rgb(161, 216, 226), rgb(187, 226, 241), rgb(210, 236, 245) and rgb(235, 246, 247)  # 色パレット (水色〜白)

	# --- Ninjutsu -爆- ---
	# 効果
	baku-count: 10  # 召喚する星の数 (最後の1個は爆風)
	baku-spacing: 1  # 星の間隔 (m)
	baku-delay: 0.5  # 星を召喚してから爆発するまでの時間 (秒)
	baku-random-power: 0.3  # 花火の爆発位置をずらす最大距離 (randomVectorのpower, 0〜この値でランダム)
	baku-firework-damage: 2  # 花火1発ごとのダメージ (❤)
	baku-explosion-power: 3  # 最後の星の爆風の威力 (kitExplosion)
	baku-firework-data: "ninjutsu-baku-firework"  # 爆遁の花火を識別するPersistentDataのキー
	# 演出
	baku-sound-pitch-min: 1  # 1個目の星の召喚音のpitch
	baku-sound-pitch-max: 1.9  # 最後の星の召喚音のpitch (星ごとに段階的に上がる)

	# --- Ninjutsu -木- ---
	# 効果
	moku-speed: 0.9  # 草の弾の発射速度
	moku-max-flight: 1  # 草の弾が着弾しなかった場合に, その位置で着弾扱いにするまでの時間 (秒)
	moku-charge: 1  # 着弾してから効果が発動するまでのチャージ時間 (秒)
	moku-radius: 5  # 効果範囲 (着弾地点からの半径 m)
	moku-heal: 2  # 味方(自分を含む)の回復量 (❤)
	moku-invisible: 3  # 味方(自分を含む)に付与する透明化の時間 (秒)
	moku-grass-time: 3  # 見た目だけの草ブロックを展開する時間 (秒)
	moku-projectile-data: "ninjutsu-moku"  # 草の弾を識別するPersistentDataのキー
	moku-landed-data: "Ninjutsu MOKU - Landed"  # 草の弾が着弾済みかを記録するmetadataのキー

import:
	org.bukkit.event.entity.EntityDamageByEntityEvent

on load:
	register item tag named "ninjutsu-dye" using orange dye, light blue dye, yellow dye, lime dye, gray dye, cyan dye, blue dye, red dye

function kitEffect_Ninjutsu_LeftClick(player: player):
	set {_tool} to {_player}'s tool
	playSound("ui.button.click", 1, 1, {_player}, true)
	if getKitStats({_player}, "Ninjutsu1") is not set:
		setKitStats({_player}, "Ninjutsu1", "L")
		send action bar "§a§lL §6- §7§l? §6- §7§l?" to {_player}
		set {_now} to now
		setKitStats({_player}, "NinTime", {_now})
		wait 3 seconds
		if getKitStats({_player}, "NinTime") is {_now}:
			deleteKitStats({_player}, "Ninjutsu1")
	else if getKitStats({_player}, "Ninjutsu1") is set:
		if getKitStats({_player}, "Ninjutsu2") is not set:
			setKitStats({_player}, "Ninjutsu2", "L")
			set {_Nin1} to getKitStats({_player}, "Ninjutsu1")
			send action bar "§a§l%{_Nin1}% §6- §a§lL §6- §7§l?" to {_player}
			set {_now} to now
			setKitStats({_player}, "NinTime", {_now})
			wait 3 seconds
			if getKitStats({_player}, "NinTime") is {_now}:
				deleteKitStats({_player}, "Ninjutsu1")
				deleteKitStats({_player}, "Ninjutsu2")
		else:
			deleteKitStats({_player}, "NinTime")
			setKitStats({_player}, "Ninjutsu3", "L")
			set {_Nin1} to getKitStats({_player}, "Ninjutsu1")
			set {_Nin2} to getKitStats({_player}, "Ninjutsu2")
			set {_Nin3} to getKitStats({_player}, "Ninjutsu3")
			send action bar "§a§l%{_Nin1}% §6- §a§l%{_Nin2}% §6- §a§lL" to {_player}
			kitMsg({_player}, "§f§l印を結びました!")
			playSound("entity.item.pickup", 1, 0.5, {_player}, true)
			set {_nin} to "%{_Nin1}% - %{_Nin2}% - %{_Nin3}%"
			deleteKitStats({_player}, "Ninjutsu1")
			deleteKitStats({_player}, "Ninjutsu2")
			deleteKitStats({_player}, "Ninjutsu3")
			if {_nin} is "L - L - L":
				set {_player}'s tool to light blue dye named "§5Ninjutsu §9[§b風§9]" with lore "§f敵を吹き飛ばす風遁の術", "§5§m------------------------------", "§f[§d§l効果§f]", "§6§l忍術", "", "§3右クリック§7:", "§8- §d前方{@kaze-distance}m§7まで進む§e竜巻§7を§6§l召喚 §b{@kaze-duration}秒", "§8- §d竜巻周辺{@kaze-hit-radius}m§7の§4敵§7を§d上方向§7に§6§l吹き飛ばす §b{@kaze-hit-interval}秒毎" and "§8- §3吹き飛ばした敵§7の§c落下ダメージ§7を§4❤{@kaze-fall-damage}§7に§6§l変更"
			else if {_nin} is "L - R - L":
				set {_player}'s tool to lime dye named "§5Ninjutsu §9[§2木§9]" with lore "§f仲間を癒やし隠す木遁の術", "§5§m------------------------------", "§f[§d§l効果§f]", "§6§l忍術", "", "§3右クリック§7:", "§8- §e草の弾§7を§d前方§7に§6§l発射", "§8- §3着弾後§b{@moku-charge}秒§7で§d着弾点周辺{@moku-radius}m§7に§e草木§7を§6§l展開", "§8- §d範囲内§7の§2自身§7と§2味方§7を§a❤{@moku-heal}§6§l回復" and "§8- §d範囲内§7の§2自身§7と§2味方§7に§b透明化§7を§6§l付与 §b{@moku-invisible}秒"
			else if {_nin} is "R - L - L":
				set {_player}'s tool to red dye named "§5Ninjutsu §9[§4火§9]" with lore "§f周辺を燃やす火遁の術", "§5§m------------------------------", "§f[§d§l効果§f]", "§6§l忍術", "", "§3右クリック§7:", "§8- §d周辺5m§cの§4敵§7に§4❤2§c§lダメージ", "§8- §d周辺5m§7に§e炎上フィールド§7を§6§l展開 §b5秒" and "§8- §dフィールド内§cの§4敵§7を§6§l着火 §b5秒"
			else if {_nin} is "R - R - L":
				set {_player}'s tool to orange dye named "§5Ninjutsu §9[§6土§9]" with lore "§f逃げ場を抑える土遁の術", "§5§m------------------------------", "§f[§d§l効果§f]", "§6§l忍術", "", "§3右クリック§7:", "§8- §d半径5m§7の§e土壁§7を§6§l設置" and "§8- §2自身§7と§d周辺5m§§2の味方§7に§a耐性 I§7を§6§l付与 §b5秒"

function kitEffect_Ninjutsu(player: player):
	set {_tool} to {_player}'s tool
	playSound("ui.button.click", 1, 1, {_player}, true)
	if getKitStats({_player}, "Ninjutsu1") is not set:
		setKitStats({_player}, "Ninjutsu1", "R")
		send action bar "§a§lR §6- §7§l? §6- §7§l?" to {_player}
		set {_now} to now
		setKitStats({_player}, "NinTime", {_now})
		wait 3 seconds
		if getKitStats({_player}, "NinTime") is {_now}:
			deleteKitStats({_player}, "Ninjutsu1")
	else if getKitStats({_player}, "Ninjutsu1") is set:
		if getKitStats({_player}, "Ninjutsu2") is not set:
			setKitStats({_player}, "Ninjutsu2", "R")
			set {_Nin1} to getKitStats({_player}, "Ninjutsu1")
			send action bar "§a§l%{_Nin1}% §6- §a§lR §6- §7§l?" to {_player}
			set {_now} to now
			setKitStats({_player}, "NinTime", {_now})
			wait 3 seconds
			if getKitStats({_player}, "NinTime") is {_now}:
				deleteKitStats({_player}, "Ninjutsu1")
				deleteKitStats({_player}, "Ninjutsu2")
		else:
			deleteKitStats({_player}, "NinTime")
			setKitStats({_player}, "Ninjutsu3", "R")
			set {_Nin1} to getKitStats({_player}, "Ninjutsu1")
			set {_Nin2} to getKitStats({_player}, "Ninjutsu2")
			set {_Nin3} to getKitStats({_player}, "Ninjutsu3")
			send action bar "§a§l%{_Nin1}% §6- §a§l%{_Nin2}% §6- §a§lR" to {_player}
			kitMsg({_player}, "§f§l印を結びました!")
			playSound("entity.item.pickup", 1, 0.5, {_player}, true)
			remove a bone meal named "§fNinjutsu" from {_player}
			set {_nin} to "%{_Nin1}% - %{_Nin2}% - %{_Nin3}%"
			deleteKitStats({_player}, "Ninjutsu1")
			deleteKitStats({_player}, "Ninjutsu2")
			deleteKitStats({_player}, "Ninjutsu3")
			wait a tick
			if {_nin} is "L - L - R":
				set {_player}'s tool to gray dye named "§5Ninjutsu §9[§8爆§9]" with lore "§f木っ端微塵にする爆遁の術", "§5§m------------------------------", "§f[§d§l効果§f]", "§6§l忍術", "", "§3右クリック§7:", "§8- §d視線方向§7に§d{@baku-spacing}mおき§7に§e星§7を§6§l召喚 §d{@baku-count}個", "§8- §e星§7は§b{@baku-delay}秒後§7に§e花火§7となって§6§l爆発", "§8- §e花火§7に当たった§4敵§7に§4❤{@baku-firework-damage}§c§lダメージ §7(1発ごと)" and "§8- §d最後の星§7のみ§c§l爆風§7を発生 §6威力{@baku-explosion-power}"
			else if {_nin} is "L - R - R":
				set {_player}'s tool to blue dye named "§5Ninjutsu §9[§1水§9]" with lore "§f心身を癒やす水遁の術", "§5§m------------------------------", "§f[§d§l効果§f]", "§6§l忍術", "", "§3右クリック§7:", "§8- §d周辺5m§7に§e水のベール§7を§6§l展開 §b5秒" and "§8- §dベール内の§2自身§dと§2味方§7を§6§l消火§7し§a再生能力 II§6§l付与"
			else if {_nin} is "R - L - R":
				set {_player}'s tool to cyan dye named "§5Ninjutsu §9[§3氷§9]" with lore "§f動きを固める氷遁の術", "§5§m------------------------------", "§f[§d§l効果§f]", "§6§l忍術", "", "§3右クリック§7:", "§8- §b1秒後§7,§d周辺5m§cの§4敵§7に§6§l凍結効果 §b2秒", "§8- §d周辺5m§7に§e氷結フィールド§7を§6§l展開 §b5秒", "§8- §dエリア内の§4敵§7に§c移動速度低下 I§6§l付与" and "§8- §b1秒間継続§7で§dエリア内にいる§4敵§7に§6§l凍結効果 §b0.25秒"
			else if {_nin} is "R - R - R":
				set {_player}'s tool to yellow dye named "§5Ninjutsu §9[§e雷§9]" with lore "§f痺れを与える雷遁の術", "§5§m------------------------------", "§f[§d§l効果§f]", "§6§l忍術", "", "§3右クリック§7:", "§8- §d周辺5m§cの§4敵§に§e固定§4❤2§c§lダメージ§7と§6§l麻痺効果 §b5秒" and "§8- §dヒットした§4敵§7を§d5m内§7に§6§l拘束 §b5秒"

on rightclick:
	set {_tool} to player's tool
	{_tool} is tagged as tag "skript:ninjutsu-dye"
	getItemName(player's tool) contains "§5Ninjutsu"
	cancel event
	if checkCT(player, "Ninjutsu") is true:
		setCT(player, "Ninjutsu", 10)
		set {_n} to player's tool
		set player's tool to air
		if "%type of {_n}%" is "light blue dye":
			kitMsg(player, "§b忍法・風遁の術!")
			set {_l} to location of player
			kitNinjutsu_KAZE(player, {_l})
		else if "%type of {_n}%" is "gray dye":
			kitMsg(player, "§8忍法・爆遁の術!")
			set {_loc} to location of player's head  # 視線方向に並べるため目の位置から
			kitNinjutsu_BAKU(player, {_loc})
		else if "%type of {_n}%" is "lime dye":
			kitMsg(player, "§2忍法・木遁の術!")
			set {_loc} to location of player
			kitNinjutsu_MOKU(player, {_loc})
		else if "%type of {_n}%" is "blue dye":
			kitMsg(player, "§1忍法・水遁の術!")
			set {_l} to location of player
			kitNinjutsu_MIZU(player, {_l})
		else if "%type of {_n}%" is "red dye":
			kitMsg(player, "§4忍法・火遁の術!")
			set {_loc} to location of player
			kitNinjutsu_HONO(player, {_loc})
		else if "%type of {_n}%" is "cyan dye":
			kitMsg(player, "§3忍法・氷遁の術!")
			set {_loc} to location of player
			kitNinjutsu_HYOU(player, {_loc})
		else if "%type of {_n}%" is "orange dye":
			kitMsg(player, "§6忍法・土遁の術!")
			set {_l} to location of player
			kitNinjutsu_TSUCHI(player, {_l})
		else if "%type of {_n}%" is "yellow dye":
			kitMsg(player, "§e忍法・雷遁の術!")
			set {_loc} to location of player
			kitNinjutsu_RAI(player, {_loc})

# Ninjutsu -風-
# 前方へ進む竜巻を召喚し, 周囲の敵を上方向に吹き飛ばす (数値は options で変更)
local function kitNinjutsu_KAZE(player: player, l: location):
	set {_ticks} to round({@kaze-duration} * 20)
	set {_step} to {@kaze-distance} / {_ticks}  # 1tickあたりの移動距離
	set {_interval} to {@kaze-hit-interval} * 20  # 再ヒット間隔 (tick)
	sendTimeBossbar_GREEN({_player}, "Ninjutsu - 風 -", {_ticks})
	# --- 竜巻の色を抽選 (パレットから重複なしで取り出す) ---
	set {_pool::*} to {@kaze-colors}
	loop {@kaze-color-count} times:
		exit loop if size of {_pool::*} is 0
		set {_i} to random element out of indices of {_pool::*}
		add {_pool::%{_i}%} to {_colors::*}
		delete {_pool::%{_i}%}
	# ------------------------------------------------------
	set {_loc} to {_l}
	set pitch of {_loc} to 0  # 進行方向は水平方向のみ
	kitParticle_Ninjutsu_KAZE_Summon({_loc})
	set {_t} to 0
	loop {_ticks} times:
		add 1 to {_t}
		# --- 竜巻の移動 (地形に沿う) ---
		set {_loc} to location {_step} meters in front of {_loc}
		if block at {_loc} is not passable:
			# 段差: 1ブロック上に登ってブロック上面に合わせる
			set {_loc} to location 1 meter above {_loc}
			set y-coordinate of {_loc} to y-coordinate of block at {_loc}
		else if block at location 0.1 meters below {_loc} is passable:
			# 足場なし: 下に降り, 地面にめり込んだらブロック上面に合わせる
			set {_loc} to location 0.25 meters below {_loc}
			if block at {_loc} is not passable:
				set y-coordinate of {_loc} to (y-coordinate of block at {_loc}) + 1
		# -----------------------------------------------------
		kitParticle_Ninjutsu_KAZE_Tornado({_loc}, {_t}, {_colors::*})
		# --- 吹き飛ばし (同じ敵へは再ヒット間隔に1回まで) ---
		loop all entities in radius {@kaze-hit-radius} around {_loc}:
			kitCheckTeam({_player}, loop-entity, false) is true
			set {_id} to "%uuid of loop-entity%"
			if {_hit::%{_id}%} is set:
				continue if {_t} - {_hit::%{_id}%} < {_interval}
			set {_hit::%{_id}%} to {_t}
			set velocity of loop-entity to vector(0, {@kaze-launch-power}, 0)
			if checkEntityType(loop-entity, player) is true:
				LastKiller(loop-entity, {_player})
				setFallDamage(loop-entity, {@kaze-fall-damage})
				kitEffectDescription(loop-entity, "§b§l吹き飛ばし")
			kitParticle_Ninjutsu_KAZE_Hit(loop-entity)
		# ----------------------------------------
		wait a tick
	kitParticle_Ninjutsu_KAZE_End({_loc})

local function kitParticle_Ninjutsu_KAZE_Summon(loc: location):  # 召喚演出
	playSound("entity.wither.shoot", 1, 0.5, {_loc})
	playSound("entity.ender_dragon.flap", 1, 0.8, {_loc})
	loop 30 times:
		set {_dl} to {_loc}
		set yaw of {_dl} to a random number between 0 and 360
		set {_v} to setVector({_dl}, location 1 meter in front of {_dl})
		spawnParticle_Vector(cloud, {_v}, 0.4, location 0.3 meters above {_dl})

local function kitParticle_Ninjutsu_KAZE_Tornado(loc: location, t: number, colors: colors):  # 竜巻演出 (毎tick)
	# 音
	if mod({_t}, 4) is 0:
		playSound("entity.phantom.flap", 0.6, 0.5, {_loc})
	chance of 10%:
		set {_pitch} to a random number between 1 and 2
		playSound("entity.wither.shoot", 0.4, {_pitch}, {_loc})
	# 竜巻本体 (根元から頂上へ向けて広がる螺旋)
	set {_baserad} to {_t} * 20
	set {_dy} to {@kaze-tornado-height} / {@kaze-tornado-layers}
	set {_dm} to ({@kaze-tornado-radius} - {@kaze-tornado-min-radius}) / {@kaze-tornado-layers}
	set {_armrad} to 360 / {@kaze-tornado-arms}
	loop {@kaze-tornado-layers} times:
		set {_y} to {_dy} * loop-number-1
		set {_m} to {@kaze-tornado-min-radius} + {_dm} * loop-number-1
		loop {@kaze-tornado-arms} times:
			set {_rad} to {_baserad} + {_armrad} * loop-number-2 + 25 * loop-number-1
			set {_el} to {_loc}
			add {_m} * sin({_rad}) to x of {_el}
			add {_m} * cos({_rad}) to z of {_el}
			add {_y} to y of {_el}
			set {_from} to random element out of {_colors::*}
			set {_to} to random element out of {_colors::*}
			spawnParticle_DustTransition({_from}, {_to}, {@kaze-particle-size}, {_el})
	# 足元の砂ぼこり
	chance of 50%:
		set {_el} to {_loc}
		add a random number between -1 and 1 to x of {_el}
		add a random number between -1 and 1 to z of {_el}
		spawnParticle(cloud, {_el})

local function kitParticle_Ninjutsu_KAZE_Hit(entity: entity):  # 吹き飛ばし演出
	playSound("entity.player.attack.sweep", 1, 1.5, {_entity})
	playSound("entity.phantom.flap", 1, 1.5, {_entity})
	spawnParticle(sweep_attack, location 1 meter above {_entity})
	loop 6 times:
		set {_el} to location of {_entity}
		add a random number between -0.5 and 0.5 to x of {_el}
		add a random number between -0.5 and 0.5 to z of {_el}
		spawnParticle_Vector(cloud, vector(0, 1, 0), 0.5, {_el})

local function kitParticle_Ninjutsu_KAZE_End(loc: location):  # 消滅演出
	playSound("entity.phantom.flap", 1, 0.5, {_loc})
	loop 15 times:
		set {_dl} to {_loc}
		set yaw of {_dl} to a random number between 0 and 360
		add a random number between 0 and 3 to y of {_dl}
		set {_v} to setVector({_dl}, location 1 meter in front of {_dl})
		spawnParticle_Vector(cloud, {_v}, 0.2, {_dl})

# Ninjutsu -爆-
# 視線方向に1tickごとに星を並べ, 一定時間後に花火として爆発させる (最後の星のみ爆風)
local function kitNinjutsu_BAKU(player: player, loc: location):
	set {_pitchstep} to ({@baku-sound-pitch-max} - {@baku-sound-pitch-min}) / max({@baku-count} - 1, 1)
	loop {@baku-count} times:
		set {_el} to location ({@baku-spacing} * loop-number) meters in front of {_loc}
		set {_pitch} to {@baku-sound-pitch-min} + {_pitchstep} * (loop-number - 1)
		if loop-number is {@baku-count}:
			kitNinjutsu_BAKU_Star({_player}, {_el}, {_pitch}, true)
		else:
			kitNinjutsu_BAKU_Star({_player}, {_el}, {_pitch}, false)
		wait a tick

# 星1個分の処理 (召喚 → 待機 → 花火 or 爆風)
local function kitNinjutsu_BAKU_Star(player: player, loc: location, pitch: number, last: boolean):
	playSound("entity.tnt.primed", 1, {_pitch}, {_loc})
	loop round({@baku-delay} * 20) times:
		kitParticle_Ninjutsu_BAKU_Star({_loc}, {_last})
		wait a tick
	# 最後の星: 召喚場所で爆風
	if {_last} is true:
		kitExplosion({_player}, {@baku-explosion-power}, {_loc})
		stop
	# 花火: ランダムな方向にずらした位置で即爆発
	set {_pow} to a random number between 0 and {@baku-random-power}
	set {_flloc} to {_loc}
	if {_pow} > 0:  # randomVector(0)は0〜2のランダムになるため除外
		set {_flloc} to {_loc} ~ randomVector({_pow})
	set {_r} to a random integer between 0 and 255
	set {_g} to a random integer between 0 and 255
	set {_b} to a random integer between 0 and 255
	set {_color} to rgb({_r}, {_g}, {_b})
	set {_explosion} to setFireWorksExplosion("ball", {_color}, {_color}, false, false)  # fadeColorは同色 (色を変化させない)
	set {_firework} to spawnFireworks_PLAYER({_player}, {_flloc}, 0, {_explosion})
	setPersistentData({_firework}, {@baku-firework-data}, true)
	setPersistentData({_firework}, kitFireworkData(), true)
	setPersistentData({_firework}, kitFireworkDataShooter(), getUUIDString({_player}))

# 花火のダメージ処理 (花火1発ごとに固定ダメージ)
on EntityDamageByEntityEvent with priority LOW:
	set {_victim} to event.getEntity()
	set {_firework} to event.getDamager()
	if getPersistentData({_firework}, {@baku-firework-data}) is not true:
		stop
	set {_attacker} to getSummonPlayer({_firework})
	if {_attacker} is not set:
		stop
	if kitCheckTeam({_victim}, {_attacker}, false) is false:
		stop

	setDamageModification_SET({_victim}, {@baku-firework-damage})
	LastKiller({_victim}, {_attacker})
	if checkEntityType({_victim}, player) is true:
		kitEffectDescription({_victim}, "§4❤{@baku-firework-damage}")

local function kitParticle_Ninjutsu_BAKU_Star(loc: location, last: boolean):  # 星の演出 (毎tick)
	spawnParticle(wax_off, {_loc})
	spawnParticle_Vector(firework, randomVector(1), 0.05, {_loc})
	if {_last} is true:
		# 爆風になる星は火の粉で区別
		spawnParticle(flame, {_loc})
		chance of 50%:
			spawnParticle(lava, {_loc})
	else:
		spawnParticle_Dust(rgb(255, 230, 120), 0.8, {_loc})

# Ninjutsu -木-
# 草の弾を発射し, 着弾地点の周囲の味方(自分を含む)を回復・透明化する (数値は options で変更)
local function kitNinjutsu_MOKU(player: player, loc: location):
	playSound("block.cherry_leaves.break", 1, 0.5, {_player})
	playSound("entity.snowball.throw", 1, 0.8, {_player})
	shoot a snowball from {_player} at speed {@moku-speed}
	set {_proj} to shot snowball
	setPersistentData({_proj}, {@moku-projectile-data}, true)
	set metadata value {@moku-landed-data} of {_proj} to false
	set item of {_proj} to oak leaves
	# --- 飛行中の演出 ---
	set {_prev} to location of {_proj}
	loop round({@moku-max-flight} * 20) times:
		wait a tick
		stop if metadata value {@moku-landed-data} of {_proj} is true
		set {_now} to location of {_proj}
		kitParticle_Ninjutsu_MOKU_Trail({_prev}, {_now})
		set {_prev} to {_now}
	# --- 一定時間着弾しなかった場合: その位置で着弾扱い ---
	stop if metadata value {@moku-landed-data} of {_proj} is true
	set metadata value {@moku-landed-data} of {_proj} to true
	set {_landloc} to location of {_proj}
	{_proj}.remove()
	kitNinjutsu_MOKU_Land({_player}, {_landloc})

# 着弾 (ブロック・エンティティどちらでも)
on projectile hit:
	projectile is a snowball
	getPersistentData(projectile, {@moku-projectile-data}) is true
	metadata value {@moku-landed-data} of projectile is false
	set metadata value {@moku-landed-data} of projectile to true
	kitNinjutsu_MOKU_Land(shooter, location of projectile)

# 草の弾が直撃した際の雪玉のノックバックを無効化
on damage with priority LOW:
	damage was caused by projectile
	projectile is a snowball
	getPersistentData(projectile, {@moku-projectile-data}) is true
	cancel event

# 着弾後: チャージ → 回復・透明化 → 草ブロック展開
local function kitNinjutsu_MOKU_Land(player: player, loc: location):
	# --- チャージ (円が徐々に広がる) ---
	playSound("block.grass.place", 1, 0.8, {_loc})
	set {_charge} to max(round({@moku-charge} * 20), 1)
	loop {_charge} times:
		set {_r} to {@moku-radius} * loop-number / {_charge}
		kitParticle_Ninjutsu_MOKU_Charge({_loc}, {_r}, loop-number)
		if mod(loop-number, 4) is 1:
			playSound("block.azalea_leaves.place", 1, 0.5 + 1.5 * loop-number / {_charge}, {_loc})
		wait a tick
	# --- 発動: 範囲内の味方(自分を含む)を回復・透明化 ---
	kitParticle_Ninjutsu_MOKU_Burst({_loc})
	loop all players in radius {@moku-radius} around {_loc}:
		kitCheckTeam(loop-player, {_player}, true) is true
		setSupporter(loop-player, {_player})
		kitHeal(loop-player, {@moku-heal})
		kitInvisible(loop-player, round({@moku-invisible} * 20))
		kitEffectDescription(loop-player, "§a❤{@moku-heal} §8& §b§l透明化")
	# --- 草ブロック展開 (見た目のみ) ---
	loop all blocks in radius {@moku-radius} around {_loc}:
		loop-block is air
		block below loop-block is not passable
		add location of loop-block to {_grasses::*}
	loop round({@moku-grass-time} * 20) times:
		loop {_grasses::*}:
			make all players see block at loop-value-2 as short grass
		wait a tick
	loop {_grasses::*}:
		make all players see block at loop-value as air
	playSound("block.rooted_dirt.break", 1, 0.5, {_loc})

local function kitParticle_Ninjutsu_MOKU_Trail(from: location, to: location):  # 草の弾の軌跡 (毎tick, 前tickの位置との間を補間)
	# 弾本体の周りに葉の塊をまとわせて大きく見せる
	loop 6 times:
		set {_el} to {_to} ~ randomVector(a random number between 0.1 and 0.35)
		spawnParticle_DustTransition(rgb(34, 139, 34), rgb(124, 252, 0), 1.5, {_el})
	spawnParticle_Block(oak leaves, {_to})
	# 前tickの位置から現在位置までを0.25mおきに埋める
	set {_distance} to distance between {_from} and {_to}
	stop if {_distance} < 0.05
	set {_base} to setDirToVec({_from}, setVector({_from}, {_to}))
	set {_count} to max(round({_distance} / 0.25), 1)
	loop {_count} times:
		set {_el} to location ({_distance} * loop-number / {_count}) meters in front of {_base}
		# 軌跡の芯 (緑 → 黄緑)
		spawnParticle_DustTransition(rgb(46, 139, 87), rgb(173, 255, 47), 1.2, {_el})
		# 舞い散る葉
		chance of 50%:
			set {_leafloc} to {_el} ~ randomVector(a random number between 0.1 and 0.5)
			spawnParticle_Block(oak leaves, {_leafloc})
		chance of 15%:
			spawnParticle(happy_villager, {_el})

local function kitParticle_Ninjutsu_MOKU_Charge(loc: location, r: number, t: number):  # チャージ演出 (毎tick)
	# 広がる円
	set {_count} to max(round({_r} * 8), 8)
	set {_addrad} to 360 / {_count}
	loop {_count} times:
		set {_rad} to {_t} * 5 + {_addrad} * loop-number
		set {_el} to {_loc}
		add {_r} * sin({_rad}) to x of {_el}
		add {_r} * cos({_rad}) to z of {_el}
		add 0.2 to y of {_el}
		spawnParticle_DustTransition(rgb(46, 139, 87), rgb(124, 252, 0), 1, {_el})
	# 中心から湧き上がる葉
	spawnParticle(happy_villager, location 0.5 meters above {_loc})
	chance of 50%:
		spawnParticle_Block(oak leaves, location 0.5 meters above {_loc})

local function kitParticle_Ninjutsu_MOKU_Burst(loc: location):  # 発動演出 (草木が破裂する)
	set {_center} to location 0.5 meters above {_loc}
	# --- 音 ---
	playSound("block.amethyst_block.break", 1, 1.3, {_loc})
	playSound("block.amethyst_block.break", 1, 1.1, {_loc})
	playSound("block.amethyst_block.break", 1, 0.9, {_loc})
	playSound("block.cherry_leaves.break", 1, 0.5, {_loc})
	playSound("item.bone_meal.use", 1, 1, {_loc})
	playSound("block.amethyst_block.chime", 1, 1.5, {_loc})
	# --- 破裂: 中心から全方向へ飛び散る ---
	loop 80 times:
		spawnParticle_Vector(totem_of_undying, randomVector(1), a random number between 0.5 and 1, {_center})
	loop 25 times:
		spawnParticle_Vector(end_rod, randomVector(1), a random number between 0.2 and 0.4, {_center})
	loop 30 times:  # 中心付近に舞う葉
		set {_el} to {_center} ~ randomVector(a random number between 0.2 and 2)
		spawnParticle_Block(oak leaves, {_el})
	# --- キラキラ: 半径5mの球体内にまき散らす (緑 + 白い光) ---
	loop 150 times:
		set {_pow} to max({@moku-radius} * (a random number between 0 and 1) ^ (1 / 3), 0.1)  # 球内に均一に分布させる
		set {_el} to {_center} ~ randomVector({_pow})
		set {_rn} to a random integer between 1 and 10
		if {_rn} <= 3:
			spawnParticle(wax_off, {_el})
		else if {_rn} <= 5:
			spawnParticle(end_rod, {_el})
		else if {_rn} <= 7:
			spawnParticle(happy_villager, {_el})
		else:
			spawnParticle_DustTransition(rgb(124, 252, 0), rgb(255, 255, 255), 0.7, {_el})
	# --- 衝撃波: 地面を広がる輪 (5tick) ---
	loop 5 times:
		set {_r} to {@moku-radius} * loop-number-1 / 5
		set {_count} to max(round({_r} * 8), 8)
		loop {_count} times:
			set {_rad} to 360 / {_count} * loop-number-2
			set {_el} to {_loc}
			add {_r} * sin({_rad}) to x of {_el}
			add {_r} * cos({_rad}) to z of {_el}
			add 0.2 to y of {_el}
			spawnParticle_DustTransition(rgb(34, 139, 34), rgb(173, 255, 47), 1.5, {_el})
			chance of 20%:
				spawnParticle_Block(oak leaves, {_el})
		wait a tick

# Ninjutsu -水-
local function kitNinjutsu_MIZU(player: player, l: location):
	# --- 座標の追加 ---
	set {_y} to (y of (block at ({_player})))
	loop all blocks in radius 5 around {_l}:
		(distance between (location of (block at ({_l}))) and (location of (loop-block))) >= 4
		y of loop-block is {_y}
		add (location of loop-block) to {_base::*}
	# ----------------
	# --- 水のベール展開 ---
	sendTimeBossbar_GREEN({_player}, "Ninjutsu - 水 -", 110)
	playSound("entity.generic.splash", 1, 1.5, {_l})
	# nmは高さ
	# chは1のときは継続して高くする それ以外はストップ
	set {_nm} to 0
	loop 10 times:
		loop {_base::*}:
			set {_bl} to loop-value-2
			set {_s} to (abs((x of ({_bl}) - (x of (location of (block at ({_l})))))) / 5)
			if {_nm} is between 0 and (4 + {_s} * 3):
				set {_ch} to 1
			else:
				set {_ch} to 0
			if {_ch} is 1:
				set {_ck} to location of block {_nm} meters above {_bl}
				block at {_ck} is air
				make all players see block at {_ck} as water
				add {_ck} to {_locations::*}
				playSound("block.grass.break", 0.5, 1.5, {_ck})
				spawnParticle_Color(entity_effect, rgb(0, 0, 200), loop-value-2)
			else:
				remove loop-value-2 from {_ci::*}
		add 1 to {_nm}
		wait a tick
	# --------------------
	# --- 展開中の処理 ---
	loop 100 times:
		delete {_joins::*}
		# --- 味方プレイヤーへの効果付与 ---
		loop all entities in radius 5 around {_l}:
			kitCheckTeam(loop-entity, {_player}, true) is true
			add loop-entity to {_joins::*}
			if {_joined::*} does not contain loop-entity:
				add loop-entity to {_joined::*}
			extinguishFireTick(loop-entity)
			if hasPotionEffect(loop-entity, regeneration) is false:
				applyEffect(loop-entity, regeneration, 2, 100)
				kitEffectDescription(loop-entity, "§d§l再生能力")
		# ------------------------------

		# --- 範囲外に出たエンティティの再生能力削除 ---
		loop {_joined::*}:
			set {_loop-entity} to loop-value-2
			if {_joins::*} does not contain {_loop-entity}:
				removePotionEffect({_loop-entity}, regeneration)
				remove {_loop-entity} from {_joined::*}
		# -------------------------------------------

		# ---ブロック表示 ---
		loop {_locations::*}:
			make all players see block at loop-value-2 as water
		# -----------------
		wait a tick
	# ------------------

	# --- エンティティの再生能力削除 ---
	loop {_joined::*}:
		set {_loop-entity} to loop-value
		removePotionEffect({_loop-entity}, regeneration)
	# -------------------------------------------

	# --- ブロックを戻す処理 ---
	playSound("ambient.underwater.exit", 1, 2, {_l})
	loop {_locations::*}:
		make all players see block at loop-value as air
	# -----------------------

# Ninjutsu -火-
local function kitNinjutsu_HONO(player: player, loc: location):
	playSound("entity.ghast.shoot", 1, 1, {_player})
	sendTimeBossbar_GREEN({_player}, "Ninjutsu - 火 -", 100)
	applyEffect({_player}, fire resistance, 1, 100)
	kitParticle_Ninjutsu_HONO_1({_loc})
	loop all entities in radius 5 around {_loc}:
		kitCheckTeam({_player}, loop-entity, false) is true
		kitDamage({_player}, loop-entity, 2, "火遁")
	loop all blocks in radius 5 around {_loc}:
		distance between {_loc} and loop-block >= 4
		loop-block is air
		block below loop-block is not passable
		set {_lb::%location of loop-block%} to location of loop-block
		set loop-block to fire
		add location of loop-block to {Block.%{_player}%::*}
	loop 100 times:
		loop all entities in radius 5 around {_loc}:
			kitCheckTeam(loop-entity, {_player}, false) is true
			if getFireTick(loop-entity) is 0:
				playSound("block.campfire.crackle", 1, 1, loop-entity)
				setFireTick(loop-entity, 100)
				kitEffectDescription(loop-entity, "§4§l着火")
				sendTimeBossbar_RED(loop-entity, "Ninjutsu - 火 -", 100)
			kitParticle_Ninjutsu_HONO_2(location of loop-entity)
		chance of 10%:
			playSound("block.furnace.fire_crackle", 1, 1.25, {_loc})
		wait a tick
	loop {_lb::*}:
		if block at loop-value is not air:
			set block at loop-value to air
		remove loop-value from {Block.%{_player}%::*}
	extinguishFireTick({_player})

local function kitParticle_Ninjutsu_HONO_1(baseloc: location):
	set pitch of {_baseloc} to 0
	loop 30 times:
		set {_dl} to {_baseloc}
		set yaw of {_dl} to a random number between 0 and 360
		set {_v} to setVector({_dl}, location 1 meter in front of {_dl})
		spawnParticle_Vector(flame, {_v}, 0.75, {_dl})
	set {_baserad} to 0
	loop 100 times:  # 5秒間
		set {_y} to 0
		set {_rad} to {_baserad}
		loop 5 times:  # 上3m(0.6mおき)
			set {_elbase} to {_baseloc}
			add 0.6 to {_y}
			loop 8 times:  # 回転
				add 45 to {_rad}
				set {_vec} to vector(5, {_y}, 0)
				set {_el} to {_elbase} ~ {_vec}
				chance of 10%:
					spawnParticle(flame, {_el})
			add 10 to {_rad}
		add 10 to {_baserad}
		wait a tick

local function kitParticle_Ninjutsu_HONO_2(loc: location):
	set pitch of {_loc} to 0
	loop 5 times:
		set {_el} to {_loc}
		set yaw of {_el} to a random number between 0 and 360
		subtract a random number between -90 and 0 from pitch of {_el}
		set {_v} to setVector({_el}, location 1 meters in front of {_el})
		spawnParticle_Vector(flame, {_v}, 0.1, {_el})

# Ninjutsu -氷-
local function kitNinjutsu_HYOU(player: player, loc: location):
	kitParticle_Ninjutsu_HYOU_1({_loc})
	wait a seconds
	kitParticle_Ninjutsu_HYOU_2({_loc})
	sendTimeBossbar_GREEN({_player}, "Ninjutsu - 氷 -", 100)
	loop all players in radius 5 around {_loc}:
		kitCheckTeam({_player}, loop-player, false) is true
		kitFreeze(loop-player, 40)
		kitEffectDescription(loop-player, "§b§l凍結")
	loop 100 times:
		delete {_jb::*}
		loop all players in radius 5 around {_loc}:
			kitCheckTeam(loop-player, {_player}, false) is true
			if getDebuffs(loop-player, "Freeze") is false:
				add 1 to {_eg::%loop-player%}
				if {_eg::%loop-player%} >= 20:
					set {_eg::%loop-player%} to 0
					kitFreeze(loop-player, 5)
					kitEffectDescription(loop-player, "§b§l凍結")
					playSound("block.glass.break", 1, 2, loop-player)
			set {_jb::%loop-player%} to true
		loop all players:
			getGameType(loop-player) is "Kit"
			{_eg::%loop-player%} is set
			if {_jb::%loop-player%} is true:
				applyEffect(loop-player, slowness, 1, 40, true)
				kitParticle_Ninjutsu_HYOU_3(loop-player)
			else:
				if {_eg::%loop-player%} > 0:
					subtract 1 from {_eg::%loop-player%}
		wait a tick
	loop all players:
		{_eg::%loop-player%} is set
		resetEffect(loop-player)

local function kitParticle_Ninjutsu_HYOU_1(loc: location):  # 発動前の溜め演出 1秒間
	add 1 to y of {_loc}
	set {_rad.in} to 0
	set {_rad.ex} to 45
	set {_meter.in} to 3
	set {_meter.ex} to 5
	loop 20 times:
		playSound("block.powder_snow.break", 1, 0.5 + 0.05 * loop-number, {_loc})
		loop 4 times:
			add 90 to {_rad.in}
			set {_el.in} to {_loc}
			add {_meter.in} * sin({_rad.in}) to x of {_el.in}
			add {_meter.in} * cos({_rad.in}) to z of {_el.in}
			spawnParticle_DustTransition(rgb(175, 238, 238), rgb(217, 238, 238), 0.8, {_el.in})
			add 90 to {_rad.ex}
			set {_el.ex} to {_loc}
			add {_meter.ex} * sin({_rad.ex}) to x of {_el.ex}
			add {_meter.ex} * cos({_rad.ex}) to z of {_el.ex}
			spawnParticle_DustTransition(rgb(37, 183, 192), rgb(130, 205, 221), 1.5, {_el.ex})
		add 3 to {_rad.in}
		add 3 to {_rad.ex}
		subtract 0.15 from {_meter.in}
		subtract 0.25 from {_meter.ex}
		wait a tick

local function kitParticle_Ninjutsu_HYOU_2(loc: location):  # 発動後の爆発とフィールド演出 5秒間
	# 爆発演出
	playSound("block.glass.break", 1, 0.5, {_loc})
	loop all blocks in radius 5 around {_loc}:
		loop-block is air
		chance of 5%:
			spawnParticle_Block(ice, location of loop-block)
		chance of 5%:
			spawnParticle_Block(blue ice, location of loop-block)
		chance of 5%:
			spawnParticle_Block(snow block, location of loop-block)
	# フィールド演出
	add 1 to y of {_loc}
	set {_rad} to 0
	loop 100 times:
		loop 8 times:
			add 45 to {_rad}
			set {_el} to {_loc}
			add 5 * sin({_rad}) to x of {_el}
			add 5 * cos({_rad}) to z of {_el}
			spawnParticle_DustTransition(rgb(0, 163, 175), rgb(131, 204, 210), 2, {_el})
		add 10 to {_rad}
		loop all blocks in radius 5 around {_loc}:
			loop-block is air
			chance of 1%:
				spawnParticle_BlockData(falling_dust, ice, location of loop-block)
			chance of 1%:
				spawnParticle_BlockData(falling_dust, blue ice, location of loop-block)
			chance of 1%:
				spawnParticle_BlockData(falling_dust, snow block, location of loop-block)
		wait a tick

local function kitParticle_Ninjutsu_HYOU_3(player: player):  # フィールド内のプレイヤー演出
	playSound("block.snow.step", 0.1, 1.1, {_player}, true)
	loop 3 times:
		set {_el} to aroundEffect({_player})
		spawnParticle_Block(snow block, {_el})

# Ninjutsu -土-
local function kitNinjutsu_TSUCHI(player: player, l: location):
	sendTimeBossbar_GREEN({_player}, "Ninjutsu - 土 -", 110)
	loop all entities in radius 5 around {_l}:
		kitCheckTeam(loop-entity, {_player}, true) is true
		setSupporter(loop-entity, {_player})
		applyEffect(loop-entity, resistance, 1, 100)
		applyEffect(loop-entity, mining fatigue, 1, 100)
		kitEffectDescription(loop-entity, "§6§l耐性")
		sendTimeBossbar_GREEN(loop-entity, "Ninjutsu - 土 -", 100)
	set {_y} to y-coordinate of block at {_player}
	loop all blocks in radius 5 around {_l}:
		distance between location of block at {_l} and location of loop-block >= 4
		y-coordinate of loop-block is {_y}
		add location of loop-block to {_ci::*}
	set {_nm} to 0
	loop 10 times:
		loop {_ci::*}:
			set {_bl} to loop-value-2
			if {_nm} is between 0 and 4:
				set {_ch} to 1
			else:
				set {_ch} to a random integer between 1 and 2
			if {_ch} is 1:
				set {_ck} to location of block {_nm} meters above {_bl}
				block at {_ck} is air
				make all players see block at {_ck} as dirt
				add {_ck} to {_lb::*}
				playSound("block.grass.break", 0.5, 1.5, {_ck})
				spawnParticle_Block(dirt, {_ck})
			else:
				remove loop-value-2 from {_ci::*}
		add 1 to {_nm}
		wait a tick
	loop 100 times:
		loop {_lb::*}:
			make all players see block at loop-value-2 as dirt
		wait a tick
	loop {_lb::*}:
		make all players see block at loop-value as air
		playSound("block.grass.break", 0.5, 1.2, loop-value)

# Ninjutsu -雷-
local function kitNinjutsu_RAI(player: player, loc: location):
	sendTimeBossbar_GREEN({_player}, "Ninjutsu - 雷 -", 100)
	strike lightning effect at {_loc}
	loop all players in radius 5 around {_loc}:
		kitCheckTeam(loop-player, {_player}, false) is true
		add loop-player to {_hitplayers::*}
		strike lightning effect at loop-player
		kitDamage({_player}, loop-player, 2, "雷遁", true)
		kitPalsy(loop-player, 100)
		kitEffectDescription(loop-player, "§4❤2 §8& §e§l麻痺 §8& §5§l拘束")
		sendTimeBossbar_RED(loop-player, "Ninjutsu - 雷 -", 100)
	loop 100 times:
		kitParticle_Ninjutsu_RAI_1(location 1 meters above {_loc})
		loop {_hitplayers::*}:
			kitParticle_Ninjutsu_RAI_2(loop-value-2)
			set {_dis} to distance between {_loc} and loop-value-2
			if {_dis} > 5:
				kitParticle_Ninjutsu_RAI_3(loop-value-2, {_loc})
				set {_vector} to setVector(location of loop-value-2, {_loc}, 0.3)
				set velocity of loop-value-2 to {_vector}
		wait a tick

local function kitParticle_Ninjutsu_RAI_1(loc: location):
	loop 36 times:
		add 10 to {_rad}
		set {_vec} to vector(5, 0, 0)
		rotate {_vec} around y-axis by {_rad}
		set {_el} to {_loc} ~ {_vec}
		spawnParticle(enchanted_hit, {_el})

local function kitParticle_Ninjutsu_RAI_2(player: player):
	set {_baseloc} to location of {_player}
	add 1 to y of {_baseloc}
	loop 4 times:
		add 90 to {_rad}
		set {_vec} to vector(0.5, 0, 0)
		rotate {_vec} around y-axis by {_rad}
		set {_el} to {_baseloc} ~ {_vec}
		spawnParticle(enchanted_hit, {_el})

local function kitParticle_Ninjutsu_RAI_3(toplayer: player, fromloc: location):
	playSound("block.beehive.work", 1, 2, {_toplayer})
	set {_vector} to setVector({_fromloc}, location 1 meter above {_toplayer})
	set {_baseloc} to {_fromloc}
	set yaw of {_baseloc} to yaw of {_vector}
	set pitch of {_baseloc} to pitch of {_vector}
	loop 50 times:
		set {_el} to location 0.1 * loop-number meters in front of {_baseloc}
		spawnParticle_Dust(rgb(215, 207, 58), 0.5, {_el})