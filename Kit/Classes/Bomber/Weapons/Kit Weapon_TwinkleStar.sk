# Weapon-Name: Twinkle Star

import:
	io.papermc.paper.event.entity.EntityLoadCrossbowEvent

# 装填完了時に装填物を花火へ変換する
# EntityLoadCrossbowEventは装填前に呼ばれるため, 1tick後に差し替える
on EntityLoadCrossbowEvent with priority MONITOR:
	# skript-reflectのイベントはキャンセル済みでも実行されるため除外する
	event.isCancelled() is false
	set {_player} to event.getEntity()
	{_player} is a player
	getGameType({_player}) is "Kit"

	wait a tick
	kitEffect_TwinkleStar_Load({_player})

local function kitEffect_TwinkleStar_Load(player: player):
	set {_item} to {_player}.getInventory().getItemInMainHand()
	type of {_item} is crossbow

	set {_itemkey} to getNamespacedKey({_item}, "item-key", "string")
	replace "'" with "" in {_itemkey}
	{_itemkey} is "TwinkleStar"

	set {_meta} to {_item}.getItemMeta()
	{_meta}.hasChargedProjectiles() is true

	load yml "plugins/skript-yaml/Kit Classes/Bomber.yml" as "firework.%{_player}%"
	set {_Firework} to yml value "kititems.Firework" from "firework.%{_player}%"
	unload yml "firework.%{_player}%"

	{_meta}.setChargedProjectiles(null)
	{_meta}.addChargedProjectile({_Firework})
	{_item}.setItemMeta({_meta})

	{_player}.getInventory().setItemInMainHand({_item})

function kitEffect_TwinkleStar_Shoot(player: player, event: object):
	getGameType({_player}) is "Kit"
	{Class::%{_player}%} is "Bomber"

	set {_proj} to {_event}.getEntity()
	set {_firework} to kitFireworkData()
	set {_shooter} to kitFireworkDataShooter()
	set {_uuid} to getUUIDString({_player})

	setPersistentData({_proj}, {_firework}, true)
	setPersistentData({_proj}, {_shooter}, {_uuid})
