import:
	io.papermc.paper.event.entity.EntityLoadCrossbowEvent
	io.papermc.paper.event.player.PlayerStopUsingItemEvent

# memo:
#	デフォルトのマックスチャージまでの時間は 24 ticks
#	クロスボウはチャージ満了の時点(長押し中)で装填が確定する (EntityLoadCrossbowEvent)
#	装填がキャンセルされた場合は毎tick再試行される
options:
	draw-time: "BOW-draw time"
	draw-start: "BOW-draw start"

on rightclick holding a bow or crossbow:
	# 装填済みクロスボウの右クリックは発射なので計測しない
	stop if isCrossbowCharged(player) is true
	set {_type} to type of player's tool
	set {_time} to 0
	set metadata value {@draw-time} of player to {_time}
	set {_now} to now
	set metadata value {@draw-start} of player to {_now}

	while metadata value {@draw-time} of player is set:
		wait a tick
		if getBowDrawTime(player) is not set:
			stop
		if type of player's tool is not {_type}:
			stop
		if getBowDrawStart(player) is not {_now}:
			stop
		add 1 to {_time}
		set metadata value {@draw-time} of player to {_time}

on shoot with priority MONITOR:
	getBowDrawTime(shooter) is set
	delete metadata value {@draw-time} of shooter
	delete metadata value {@draw-start} of shooter

on EntityLoadCrossbowEvent with priority MONITOR:
	# skript-reflectのイベントはキャンセル済みでも実行されるため除外する
	event.isCancelled() is false
	set {_entity} to event.getEntity()
	delete metadata value {@draw-time} of {_entity}
	delete metadata value {@draw-start} of {_entity}

# 装填されずに離した場合の計測終了
on PlayerStopUsingItemEvent with priority MONITOR:
	set {_item} to event.getItem()
	type of {_item} is crossbow
	set {_player} to event.getPlayer()
	delete metadata value {@draw-time} of {_player}
	delete metadata value {@draw-start} of {_player}

function isCrossbowCharged(player: player) :: boolean:
	type of (tool of {_player}) is crossbow
	set {_item} to {_player}.getInventory().getItemInMainHand()
	return {_item}.getItemMeta().hasChargedProjectiles()

function getBowDrawTime(player: player, maxTime: number = 24) :: number:
	set {_time} to metadata value {@draw-time} of {_player}
	set {_time} to 0 if {_time} is not set
	if {_time} > {_maxTime}:
		set {_time} to {_maxTime}
	return {_time}

function getBowDrawStart(player: player) :: date:
	set {_startTime} to metadata value {@draw-start} of {_player}
	return {_startTime}



options:
	arrow-damage: "arrowdamage"
	arrow-multiple: "arrowmultiple"

on damage with priority LOW:
	damage was caused by projectile
	projectile is an arrow
	if metadata value {@arrow-damage} of projectile is set:
		set {_damage} to getMetadata(projectile, {@arrow-damage})
		setDamageModification_SET(victim, {_damage})
	else if metadata value {@arrow-multiple} of projectile is set:
		set {_multiple} to getMetadata(projectile, {@arrow-multiple})
		setDamageModification_MUL(victim, {_multiple})

on shoot:
	projectile is an arrow
	set {_tool} to tool of shooter
	type of {_tool} is bow or crossbow
	kitItemTypeChecker({_tool}) is "Weapon"

	set {_pow} to getNamespacedKey({_tool}, "arrow-damage", "float")
	stop if {_pow} is not set
	setArrowMultiple(event-projectile, {_pow})

function setArrowDamage(proj: projectile, pow: number):
	setMetadata({_proj}, {@arrow-damage}, {_pow})

function setArrowMultiple(proj: projectile, pow: number):
	setMetadata({_proj}, {@arrow-multiple}, {_pow})



function startTrackProjectile(proj: projectile):
	# metadata setting
	set {_now} to now
	set metadata value "projectile tracking - START" of {_proj} to {_now}

	set {_enable} to true
	set {_rad} to 0
	while {_enable} is true:
		wait a tick
		if metadata value "projectile tracking - START" of {_proj} is not {_now}:
			delete {_enable}
			stop
		
		set {_loc} to location of {_proj}
		set {_proloc} to metadata value "projectile tracking - SAVE" of {_proj}
		if {_proloc} is set:
			if {_proloc} is {_loc}:
				delete metadata value "projectile tracking - START" of {_proj}
				delete metadata value "projectile tracking - SAVE" of {_proj}
				delete {_enable}
				stop

		set metadata value "projectile tracking - SAVE" of {_proj} to {_loc}

function getProjectilePreviousLocation(proj: projectile) :: location:
	set {_proloc} to metadata value "projectile tracking - SAVE" of {_proj}
	set {_loc} to location of {_proj}
	set {_proloc} to setDirToVec({_proloc}, setVector({_proloc}, {_loc}))
	if pitch of {_proloc} is not between -90 and 90:
		set pitch of {_proloc} to 0
	return {_proloc}

on projectile hit:
	metadata value "projectile tracking - START" of projectile is set
	delete metadata value "projectile tracking - START" of projectile



function getShooter(proj: entity) :: object:
	return {_proj}.getShooter()

function setShooter(proj: entity, shooter: living entity):
	{_proj}.setShooter({_shooter})