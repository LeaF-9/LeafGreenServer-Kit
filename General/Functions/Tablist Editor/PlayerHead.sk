import:
	com.comphenix.protocol.wrappers.WrappedGameProfile
	com.comphenix.protocol.wrappers.WrappedSignedProperty
	org.bukkit.entity.Player





public record PlayerHead(String textureValue, String textureSignature) {

    /** テクスチャ未指定時（空スロット）に使うデフォルトヘッド */
    public static final PlayerHead BLANK = new PlayerHead(null, null);

    /** Mojangのbase64テクスチャ値から作成（署名なし・自己ホスト等） */
    public static PlayerHead of(String textureValue) {
        return new PlayerHead(textureValue, null);
    }

    /** base64テクスチャ値＋署名から作成（Mojang公式APIから取得した場合） */
    public static PlayerHead of(String textureValue, String textureSignature) {
        return new PlayerHead(textureValue, textureSignature);
    }

    /** オンラインプレイヤーのスキンをそのまま流用する場合 */
    public static PlayerHead of(Player player) {
        WrappedGameProfile profile = WrappedGameProfile.fromPlayer(player);
        return profile.getProperties().get("textures").stream()
                .findFirst()
                .map(p -> new PlayerHead(p.getValue(), p.getSignature()))
                .orElse(BLANK);
    }

    WrappedSignedProperty toProperty() {
        if (textureValue == null) return null;
        return new WrappedSignedProperty("textures", textureValue, textureSignature);
    }
}