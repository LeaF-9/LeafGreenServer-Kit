import:
	java.net.http.HttpClient
	java.net.http.HttpRequest
	java.net.http.HttpResponse
	java.net.http.HttpResponse$BodyHandlers
	java.net.URI
	java.time.Duration
	com.google.gson.JsonParser
	java.util.ArrayList

function tablist_http_get(url: text) :: object:
	set {_client} to HttpClient.newBuilder().connectTimeout(Duration.ofSeconds(5)).build()
	set {_request} to HttpRequest.newBuilder().uri(URI.create({_url})).timeout(Duration.ofSeconds(5)).GET().build()
	set {_response} to {_client}.send({_request}, BodyHandlers.ofString())
	return {_response}.body()

# 戻り値は [textureValue, textureSignature] の2要素ArrayList
function tablist_fetch_head_by_uuid(uuid: text) :: object:
	set {_result} to new ArrayList()
	{_result}.add("")
	{_result}.add("")

	set {_uuidnodash} to {_uuid}.replace("-", "")
	set {_urlBase} to "https://sessionserver.mojang.com/session/minecraft/profile/"
	set {_url} to "%{_urlBase}%%{_uuidnodash}%"
	set {_body} to tablist_http_get({_url})
	set {_json} to JsonParser.parseString({_body}).getAsJsonObject()
	if {_json} is not set:
		return {_result}

	set {_properties} to {_json}.getAsJsonArray("properties")
	if {_properties} is not set:
		return {_result}

	set {_size} to {_properties}.size()
	set {_i} to 0
	while {_i} < {_size}:
		set {_prop} to {_properties}.get({_i}).getAsJsonObject()
		if {_prop}.get("name").getAsString() is "textures":
			set {_result} to new ArrayList()
			{_result}.add({_prop}.get("value").getAsString())
			if {_prop}.has("signature"):
				{_result}.add({_prop}.get("signature").getAsString())
			else:
				{_result}.add("")
			return {_result}
		add 1 to {_i}

	return {_result}

function tablist_fetch_head_by_username(username: text) :: object:
	set {_empty} to new ArrayList()
	{_empty}.add("")
	{_empty}.add("")

	set {_urlBase} to "https://api.mojang.com/users/profiles/minecraft/"
	set {_url} to "%{_urlBase}%%{_username}%"
	set {_body} to tablist_http_get({_url})
	set {_json} to JsonParser.parseString({_body}).getAsJsonObject()

	if {_json} is not set:
		return {_empty}
	if {_json}.has("id") is false:
		return {_empty}

	return tablist_fetch_head_by_uuid({_json}.get("id").getAsString())