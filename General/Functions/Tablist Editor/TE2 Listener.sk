import:
	com.github.retrooper.packetevents.PacketEvents
	com.github.retrooper.packetevents.event.PacketListener
	com.github.retrooper.packetevents.event.PacketListenerPriority
	com.github.retrooper.packetevents.protocol.packettype.PacketType
	com.github.retrooper.packetevents.wrapper.play.server.WrapperPlayServerPlayerInfoUpdate
	com.github.retrooper.packetevents.wrapper.play.server.WrapperPlayServerPlayerInfoUpdate$Action

	java.util.ArrayList

function tablist_on_packet_send(proxyself: object, event: object):
	if {_event}.getPacketType() is not PacketType.Play.Server.PLAYER_INFO_UPDATE:
		stop

	set {_packet} to new WrapperPlayServerPlayerInfoUpdate({_event})
	set {_entries} to {_packet}.getEntries()
	if {_entries} is not set:
		stop

	set {_size} to {_entries}.size()
	set {_hasrealplayer} to false
	set {_i} to 0
	while {_i} < {_size}:
		set {_entry} to {_entries}.get({_i})
		set {_profile} to {_entry}.getGameProfile()
		if {_profile} is set:
			if {-tablist::fakeuuid::*} does not contain {_profile}.getUUID():
				set {_hasrealplayer} to true
		add 1 to {_i}

	if {_hasrealplayer} is false:
		stop

	set {_newentries} to new ArrayList()
	set {_i} to 0
	while {_i} < {_size}:
		set {_entry} to {_entries}.get({_i})
		set {_profile} to {_entry}.getGameProfile()

		if {_profile} is not set:
			# プロフィールを含まない更新(ping等)はそのまま通す
			{_newentries}.add({_entry})
		else if {-tablist::fakeuuid::*} contains {_profile}.getUUID():
			{_newentries}.add({_entry})
		else:
			set {_newentry} to new WrapperPlayServerPlayerInfoUpdate.PlayerInfo({_profile}, false, {_entry}.getLatency(), {_entry}.getGameMode(), {_entry}.getDisplayName(), {_entry}.getChatSession())
			{_newentries}.add({_newentry})
		add 1 to {_i}

	set {_actions} to {_packet}.getActions()
	{_actions}.add(Action.UPDATE_LISTED)
	{_packet}.setActions({_actions})
	{_packet}.setEntries({_newentries})
	{_event}.markForReEncode(true)

on load:
	set {_functions::onPacketSend} to function reference "tablist_on_packet_send"
	set {-tablist::listener} to new proxy instance of PacketListener using {_functions::*}
	PacketEvents.getAPI().getEventManager().registerListener({-tablist::listener}, PacketListenerPriority.NORMAL)