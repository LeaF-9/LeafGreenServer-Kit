import:
	org.bukkit.Bukkit
	ch.njol.skript.Skript
	java.lang.Runnable
	java.util.UUID
	com.comphenix.protocol.wrappers.WrappedGameProfile

# メインスレッドに戻ってからsetTablistSlotを実際に適用する
function tablist_apply_resolved(slot: number, text: string, texturevalue: string, texturesignature: string, proxyself: object):
	setTablistSlot({_slot}, {_text}, {_texturevalue}, {_texturesignature})

function tablist_resolve_username_async(slot: number, text: string, username: string, proxyself: object):
	set {_head} to tablist_fetch_head_by_username({_username})

	set {_functions::run} to function reference "tablist_apply_resolved" called with arguments {_slot}, {_text}, {_head}.get(0), {_head}.get(1)
	set {_runnable} to new proxy instance of Runnable using {_functions::*}
	Bukkit.getScheduler().runTask(Skript.getInstance(), {_runnable})

function tablist_resolve_uuid_async(slot: number, text: string, uuidnodash: string, proxyself: object):
	set {_head} to tablist_fetch_head_by_uuid({_uuidnodash})

	set {_functions::run} to function reference "tablist_apply_resolved" called with arguments {_slot}, {_text}, {_head}.get(0), {_head}.get(1)
	set {_runnable} to new proxy instance of Runnable using {_functions::*}
	Bukkit.getScheduler().runTask(Skript.getInstance(), {_runnable})

# ---- ① オンラインプレイヤーから直接指定 ----
function setTablistSlotFromPlayer(slot: number, text: string, target: player):
	set {_profile} to WrappedGameProfile.fromPlayer({_target})
	set {_textures} to {_profile}.getProperties().get("textures")

	if {_textures} is not set or {_textures}.isEmpty():
		setTablistSlot({_slot}, {_text}, "", "")
		stop

	set {_first} to {_textures}.iterator().next()
	setTablistSlot({_slot}, {_text}, {_first}.getValue(), {_first}.getSignature())

# ---- ② アカウント名から指定(オンラインなら同期即時/オフラインならMojang APIへ非同期問い合わせ) ----
function setTablistSlotFromUsername(slot: number, text: string, username: string):
	set {_online} to Bukkit.getPlayerExact({_username})
	if {_online} is set:
		setTablistSlotFromPlayer({_slot}, {_text}, {_online})
		stop

	set {_functions::run} to function reference "tablist_resolve_username_async" called with arguments {_slot}, {_text}, {_username}
	set {_runnable} to new proxy instance of Runnable using {_functions::*}
	Bukkit.getScheduler().runTaskAsynchronously(Skript.getInstance(), {_runnable})

# ---- ③ UUID文字列から指定(同上) ----
function setTablistSlotFromUuid(slot: number, text: string, uuidstring: string):
	set {_uuid} to UUID.fromString({_uuidstring})
	set {_online} to Bukkit.getPlayer({_uuid})
	if {_online} is set:
		setTablistSlotFromPlayer({_slot}, {_text}, {_online})
		stop

	set {_nodash} to {_uuidstring}.replace("-", "")
	set {_functions::run} to function reference "tablist_resolve_uuid_async" called with arguments {_slot}, {_text}, {_nodash}
	set {_runnable} to new proxy instance of Runnable using {_functions::*}
	Bukkit.getScheduler().runTaskAsynchronously(Skript.getInstance(), {_runnable})